  "recommendations": {
    "title": "AI Recommendations",
    "subtitle": "Your AI assistant reviews database records and public research to suggest new opportunities and prioritize projects that have not started. Started work stays protected. You approve every action.",
    "researchPlaceholder": "Ask a question about your portfolio",
    "askLabel": "Ask assistant",
    "quickPrompts": [
      { "label": "Not-started priorities", "prompt": "Which confirmed not-started projects should be prioritized next, and why? Keep started work unchanged." },
      { "label": "Available capacity", "prompt": "Which not-started projects fit available skill capacity without disrupting started commitments?" },
      { "label": "New opportunities", "prompt": "What genuinely new projects should each portfolio consider? Check the full register for existing or overlapping work first." }
    ]
  },
