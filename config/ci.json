{
  "schemaVersion": 1,
  "description": "CI/CD settings for GitHub Actions. Azure and Fabric identifiers come from infra/config/pmo-deployment.json, read at runtime by scripts/ci/read-config.mjs. Workflow path filters are static in each workflow file and must match the component folders below.",
  "python": {
    "version": "3.12"
  },
  "node": {
    "version": "22"
  },
  "terraform": {
    "version": "1.9.8"
  },
  "bicep": {
    "minimumVersion": "0.30.0"
  },
  "powershell": {
    "shell": "pwsh"
  },
  "components": {
    "ui": {
      "workingDirectory": "ui",
      "buildCommand": "npm ci && npm run build",
      "artifactDirectory": "ui/www",
      "serverWorkingDirectory": "ui/server",
      "serverTestCommand": "uv run pytest",
      "appServiceSetting": "ui"
    },
    "api": {
      "workingDirectory": "api",
      "buildCommand": "uv sync --frozen && uv run pytest",
      "artifactDirectory": "api",
      "openApiExport": "docs/api/openapi.json"
    },
    "fabric": {
      "notebooksDirectory": "fabric/ml-notebooks",
      "buildScript": "fabric/scripts/build_notebooks.py",
      "deployScript": "fabric/scripts/deploy_fabric_items.py",
      "pipelinesDirectory": "fabric/pipelines",
      "powerbiDirectory": "fabric/powerbi"
    },
    "data": {
      "workingDirectory": "data-generator",
      "generatedDirectory": "data",
      "generateCommand": "uv run python generate_pmo_data.py",
      "uploadCommand": "uv run python upload_to_onelake.py"
    },
    "infraBicep": {
      "templateFile": "infra/bicep/main.bicep",
      "configFile": "infra/config/pmo-deployment.json"
    },
    "infraTerraform": {
      "workingDirectory": "infra/terraform",
      "configFile": "infra/config/pmo-deployment.json"
    }
  }
}
